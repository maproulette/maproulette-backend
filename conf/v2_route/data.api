###
# tags: [ User ]
# operationId: data_get_recent_user_activity
# summary: Get recent user activity
# description: Recent task actions by the given users, newest first. Requires authentication.
# responses:
#   '200':
#     description: The recent actions
#     content:
#       application/json:
#         schema:
#           type: array
#           items:
#             type: object
#             description: A recent task action. user, task and challenge are only included when includeDetails is set.
#             properties:
#               id:
#                 type: integer
#                 format: int64
#               created:
#                 description: Epoch milliseconds, or an ISO 8601 string when includeDetails is set
#                 oneOf:
#                   - type: integer
#                     format: int64
#                   - type: string
#                     format: date-time
#               osmUserId:
#                 type: integer
#                 format: int64
#               typeId:
#                 type: integer
#                 description: The type of item acted on, 0 project, 1 challenge, 2 task
#               parentId:
#                 type: integer
#                 format: int64
#               parentName:
#                 type: string
#               itemId:
#                 type: integer
#                 format: int64
#               action:
#                 type: integer
#               status:
#                 type: integer
#               extra:
#                 type: string
#               user:
#                 type: object
#                 nullable: true
#                 properties:
#                   id:
#                     type: integer
#                     format: int64
#                   osmProfile:
#                     $ref: '#/components/schemas/PublicOSMUser'
#               task:
#                 type: object
#                 nullable: true
#                 properties:
#                   id:
#                     type: integer
#                     format: int64
#                   location:
#                     type: object
#                     description: GeoJSON point of the task's location
#               challenge:
#                 type: object
#                 nullable: true
#                 properties:
#                   id:
#                     type: integer
#                     format: int64
#                   name:
#                     type: string
#                   general:
#                     type: object
#                     properties:
#                       parent:
#                         type: object
#                         nullable: true
#                         properties:
#                           id:
#                             type: integer
#                             format: int64
#                           name:
#                             type: string
#                           displayName:
#                             type: string
# parameters:
#   - name: osmUserIds
#     in: query
#     description: Comma-separated OSM user ids. Defaults to the current user; -1 returns activity from all users.
#     schema:
#       type: string
#   - name: limit
#     in: query
#     description: The maximum number of actions to return
#     schema:
#       type: integer
#   - name: offset
#     in: query
#     description: The number of actions to skip
#     schema:
#       type: integer
#   - name: includeDetails
#     in: query
#     description: Include each action's user, task and challenge
#     schema:
#       type: boolean
###
GET     /data/user/activity                         @org.maproulette.controllers.api.DataController.getRecentUserActivity(osmUserIds:String ?= "", limit:Int ?= -1, offset:Int ?= 0, includeDetails:Boolean ?= false)
